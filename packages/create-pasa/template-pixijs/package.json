    "@stereopasa/prettier-config": "~1.2.5",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "eslint": "^9.39.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
